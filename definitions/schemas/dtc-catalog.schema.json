{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lt1diagnostics.local/schemas/dtc-catalog.schema.json",
  "title": "LT1Diagnostics source DTC flag catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "definitionVersion", "verificationStatus", "productionEligible", "catalogId", "datasetId", "statusKind", "entries", "sourceReferences"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "definitionVersion": { "type": "string", "minLength": 1 },
    "verificationStatus": { "enum": ["Unverified", "Verified", "Superseded"] },
    "productionEligible": { "type": "boolean" },
    "catalogId": { "type": "string", "minLength": 1 },
    "datasetId": { "type": "integer", "minimum": 0, "maximum": 255 },
    "statusKind": { "enum": ["Logged", "Current", "Unknown"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "sourceTitle", "dataByteOffset", "bit", "sourceReference"],
        "properties": {
          "code": { "type": "integer", "minimum": 1 },
          "sourceTitle": { "type": "string", "minLength": 1 },
          "dataByteOffset": { "type": "integer", "minimum": 0 },
          "bit": { "type": "integer", "minimum": 0, "maximum": 7 },
          "sourceReference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceReferences": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "verificationStatus": { "const": "Unverified" } } },
      "then": { "properties": { "productionEligible": { "const": false } } }
    }
  ]
}
