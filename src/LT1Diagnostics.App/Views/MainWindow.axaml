<Window
    x:Class="LT1Diagnostics.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LT1Diagnostics.App.Converters"
    xmlns:protocol="using:LT1Diagnostics.Protocol.A276"
    xmlns:transport="using:LT1Diagnostics.Transport.Abstractions"
    xmlns:vm="using:LT1Diagnostics.App.ViewModels"
    Title="Maietta Diagnostics"
    Width="1440"
    Height="900"
    MinWidth="1120"
    MinHeight="720"
    Background="#F6F8FB"
    Foreground="#0F172A"
    FontSize="14"
    FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">

  <Window.Styles>
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="#64748B" />
    </Style>
    <Style Selector="TextBlock.kicker.help">
      <Setter Property="Cursor" Value="Help" />
      <Setter Property="ToolTip.ShowDelay" Value="100" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="500" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#101828" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#84ADFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MaxWidth" Value="390" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.7" />
      <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style Selector="TextBlock.heroTitle">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.4" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1E293B" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="#667085" />
      <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="LetterSpacing" Value="-0.4" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7DEE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #120F172A" />
    </Style>
    <Style Selector="Border.elevated">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7DEE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #140F172A" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Ellipse.connectionDot">
      <Setter Property="Fill" Value="#94A3B8" />
    </Style>
    <Style Selector="Ellipse.connectionDot.connected">
      <Setter Property="Fill" Value="#22C55E" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="#F1F5F9" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#DBEAFE" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  HorizontalAlignment="Stretch">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.nav TextBlock">
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#182230" />
      <Setter Property="Foreground" Value="#F8F9F6" />
    </Style>
    <Style Selector="Button.nav:pointerover TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#1D2939" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.nav.active TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.nav Border.navGlyph">
      <Setter Property="Background" Value="#1D2939" />
      <Setter Property="BorderBrush" Value="#344054" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav.active Border.navGlyph">
      <Setter Property="Background" Value="#155EEF" />
      <Setter Property="BorderBrush" Value="#155EEF" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="124" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Background" Value="#155EEF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#004EEB" />
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#1E40AF" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.72" />
      <Setter Property="Background" Value="#94A3B8" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="116" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#155EEF" />
      <Setter Property="BorderBrush" Value="#84ADFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#EFF4FF" />
      <Setter Property="BorderBrush" Value="#528BFF" />
    </Style>
    <Style Selector="Button.secondary:pressed">
      <Setter Property="Background" Value="#BFDBFE" />
    </Style>
    <Style Selector="Button.secondary:disabled">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="252,*">
    <Border Grid.Column="0" Background="#0B1220">
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,18,16,16">
        <StackPanel Grid.Row="0" Spacing="16">
          <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
            <Border Width="44" Height="44" Background="#155EEF" CornerRadius="10">
              <TextBlock Text="MD" FontSize="14" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="MAIETTA DIAGNOSTICS" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="0.7" />
              <TextBlock Text="GM 4L60E MODULE" FontSize="9" Foreground="#98A2B3" LetterSpacing="0.8" />
            </StackPanel>
          </Grid>

          <Border Background="#111C2E" BorderBrush="#26344A" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel Spacing="5">
              <TextBlock Text="ACTIVE VEHICLE" FontSize="9" FontWeight="Bold" Foreground="#98A2B3" LetterSpacing="1.2" />
              <TextBlock Text="1994 Buick Roadmaster" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
              <TextBlock Text="5.7L LT1  ·  4L60E" FontSize="12" Foreground="#B3C0D1" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="3">
          <TextBlock Text="START" Margin="10,0,0,6" FontSize="9" FontWeight="Bold" Foreground="#667085" LetterSpacing="1.3" />

          <Button Classes="nav" Classes.active="{Binding IsOverviewPage}" Command="{Binding NavigateOverviewCommand}" AutomationProperties.Name="Overview">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <Border Classes="navGlyph" Width="26" Height="26" CornerRadius="6"><TextBlock Text="01" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" Text="Overview" FontSize="14" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsConnectPage}" Command="{Binding NavigateConnectCommand}" AutomationProperties.Name="New capture">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <Border Classes="navGlyph" Width="26" Height="26" CornerRadius="6"><TextBlock Text="02" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" Text="New capture" FontSize="14" />
            </Grid>
          </Button>
          <TextBlock Text="ANALYZE" Margin="10,14,0,6" FontSize="9" FontWeight="Bold" Foreground="#667085" LetterSpacing="1.3" />
          <Button Classes="nav" Classes.active="{Binding IsTroubleCodesPage}" Command="{Binding NavigateTroubleCodesCommand}" AutomationProperties.Name="Trouble codes">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <Border Classes="navGlyph" Width="26" Height="26" CornerRadius="6"><TextBlock Text="03" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" Text="Trouble codes" FontSize="14" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsLiveDataPage}" Command="{Binding NavigateLiveDataCommand}" AutomationProperties.Name="Measurements">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <Border Classes="navGlyph" Width="26" Height="26" CornerRadius="6"><TextBlock Text="04" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" Text="Measurements" FontSize="14" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsTransmissionPage}" Command="{Binding NavigateTransmissionCommand}" AutomationProperties.Name="Transmission">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <Border Classes="navGlyph" Width="26" Height="26" CornerRadius="6"><TextBlock Text="05" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" Text="Transmission" FontSize="14" />
            </Grid>
          </Button>

          <TextBlock Text="RECORDS" Margin="10,14,0,6" FontSize="9" FontWeight="Bold" Foreground="#667085" LetterSpacing="1.3" />
          <Button Classes="nav" Classes.active="{Binding IsSessionsPage}" Command="{Binding NavigateSessionsCommand}" AutomationProperties.Name="Saved sessions">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <Border Classes="navGlyph" Width="26" Height="26" CornerRadius="6"><TextBlock Text="06" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" Text="Saved sessions" FontSize="14" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsReportsPage}" Command="{Binding NavigateReportsCommand}" AutomationProperties.Name="Reports">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
              <Border Classes="navGlyph" Width="26" Height="26" CornerRadius="6"><TextBlock Text="07" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" Text="Reports" FontSize="14" />
            </Grid>
          </Button>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#26344A" BorderThickness="0,1,0,0" Padding="10,14,10,0">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Ellipse Width="7" Height="7" Fill="#32D583" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="CAPTURE-ONLY MODE" FontSize="9" FontWeight="Bold" Foreground="#EAECF0" LetterSpacing="0.8" />
            </Grid>
            <TextBlock Text="No PCM or transmission controls" FontSize="11" Foreground="#98A2B3" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="68,*">
      <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
        <Grid Margin="30,0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Classes="connectionDot" Classes.connected="{Binding IsConnected}" Width="8" Height="8" />
            <TextBlock Text="{Binding ConnectionStatus}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" />
            <Border Width="1" Height="16" Background="#D0D5DD" Margin="2,0" />
            <TextBlock Text="{Binding DeviceSummary}" FontSize="13" Foreground="#667085" TextTrimming="CharacterEllipsis" MaxWidth="500" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="New capture" Command="{Binding NavigateConnectCommand}" MinHeight="38" MinWidth="108" Padding="14,0" />
          <Button Grid.Column="2" Classes="secondary" Content="Help" Command="{Binding NavigateGuideCommand}" MinHeight="38" MinWidth="72" Padding="14,0" />
          <Border Grid.Column="3" Background="#EFF4FF" BorderBrush="#D1E0FF" BorderThickness="1" CornerRadius="14" Padding="12,6">
            <TextBlock Text="A276  ·  PARKED SNAPSHOT" FontSize="9" FontWeight="Bold" Foreground="#155EEF" LetterSpacing="0.9" />
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid Margin="34,30,34,38" MaxWidth="1480" HorizontalAlignment="Stretch">
          <!-- Help and installation -->
          <StackPanel IsVisible="{Binding IsGuidePage}" Spacing="24">
            <Grid ColumnDefinitions="*">
              <StackPanel Spacing="7">
                <TextBlock Classes="kicker" Text="HELP" />
                <TextBlock Classes="pageTitle" Text="Help &amp; installation" />
                <TextBlock Classes="muted" Text="Reference information that is not part of the everyday diagnostic workflow." />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="18">
              <Border Grid.Column="0" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12" Padding="22">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="14">
                  <Border Width="40" Height="40" Background="#FFFAEB" BorderBrush="#FEC84B" BorderThickness="1" CornerRadius="20"><TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#B54708" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Real-time road capture is not enabled" FontSize="17" FontWeight="SemiBold" Foreground="#7A2E0E" />
                    <TextBlock Text="The current coordinator collects one bounded snapshot. Continuous requests remain locked until the polling cadence and return-to-normal behavior are measured on the target Roadmaster." FontSize="14" Foreground="#93370D" TextWrapping="Wrap" LineHeight="21" />
                    <TextBlock Text="A future Road session will be a separate, second-person-operated mode with an immediate stop control and automatic quality gating." FontSize="13" Foreground="#B54708" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="22">
                <StackPanel Spacing="14">
                  <TextBlock Classes="kicker" Text="STATUS LANGUAGE" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Background="#ECFDF3" CornerRadius="12" Padding="10,5"><TextBlock Text="READY" FontSize="10" FontWeight="Bold" Foreground="#067647" /></Border>
                    <TextBlock Grid.Column="1" Text="Both requested messages arrived." FontSize="14" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Background="#FFF7ED" CornerRadius="12" Padding="10,5"><TextBlock Text="CHECK" FontSize="10" FontWeight="Bold" Foreground="#B54708" /></Border>
                    <TextBlock Grid.Column="1" Text="Something was missing; read the explanation." FontSize="14" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Background="#F2F4F7" CornerRadius="12" Padding="10,5"><TextBlock Text="PENDING" FontSize="10" FontWeight="Bold" Foreground="#475467" /></Border>
                    <TextBlock Grid.Column="1" Text="Useful evidence, not yet a repair conclusion." FontSize="14" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <Expander Header="Install on another computer" FontSize="15" FontWeight="SemiBold">
              <Border Classes="card" Margin="0,10,0,0" Padding="22">
                <StackPanel Spacing="14">
                  <TextBlock Classes="muted" Text="Copy a download link and send it to the other computer." />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Classes="inset" Padding="18">
                      <StackPanel Spacing="10"><TextBlock Classes="kicker" Text="WINDOWS 10 / 11  ·  ZIP" /><Button Classes="primary" Content="Copy Windows download link" Click="CopyWindowsDownloadLink_Click" HorizontalAlignment="Stretch" /><TextBlock Classes="muted" Text="Extract the ZIP, open the folder, then double-click Install.cmd." TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="inset" Padding="18">
                      <StackPanel Spacing="10"><TextBlock Classes="kicker" Text="LINUX X64  ·  TAR.GZ" /><Button Classes="primary" Content="Copy Linux download link" Click="CopyLinuxDownloadLink_Click" HorizontalAlignment="Stretch" /><TextBlock Classes="muted" Text="Extract the package, open the folder in a terminal, then run bash install.sh." TextWrapping="Wrap" /></StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>

          <!-- Overview -->
          <StackPanel IsVisible="{Binding IsOverviewPage}" Spacing="24">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="7">
                <TextBlock Classes="kicker" Text="OVERVIEW / 01" />
                <TextBlock Classes="pageTitle" Text="GM 4L60E diagnostics" />
                <TextBlock Classes="muted" Text="Capture preserved vehicle evidence, then move directly into analysis." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <Button Classes="secondary" Content="Help" Command="{Binding NavigateGuideCommand}" />
                <Button Classes="primary" Content="New capture  →" Command="{Binding NavigateConnectCommand}" />
              </StackPanel>
            </Grid>

            <Border IsVisible="{Binding ShowNoTransmissionData}" Background="#0F172A" CornerRadius="14" Padding="30">
              <Grid ColumnDefinitions="1.25*,0.75*" ColumnSpacing="36">
                <StackPanel Spacing="12" VerticalAlignment="Center">
                  <TextBlock Text="NEXT ACTION" FontSize="10" FontWeight="Bold" Foreground="#84ADFF" LetterSpacing="1.2" />
                  <TextBlock Classes="heroTitle" Text="Capture a parked snapshot" />
                  <TextBlock Text="Connect the ALDL cable, identify the interface, and collect the two requested Roadmaster messages. The original bytes are saved before analysis begins." FontSize="15" Foreground="#D0D5DD" TextWrapping="Wrap" LineHeight="23" MaxWidth="720" HorizontalAlignment="Left" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,7,0,0">
                    <Button Classes="primary" Content="Open new capture  →" Command="{Binding NavigateConnectCommand}" />
                    <Button Classes="secondary" Content="Load sample data" Command="{Binding RunDemoCommand}" />
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#111C2E" BorderBrush="#344054" BorderThickness="1" CornerRadius="10" Padding="20">
                  <StackPanel Spacing="14">
                    <TextBlock Text="CAPTURE PLAN" FontSize="10" FontWeight="Bold" Foreground="#98A2B3" LetterSpacing="1.1" />
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="10"><Border Width="26" Height="26" Background="#1D2939" CornerRadius="13"><TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#84ADFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Select data link" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" /><TextBlock Text="USB ALDL interface" FontSize="12" Foreground="#98A2B3" /></StackPanel></Grid>
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="10"><Border Width="26" Height="26" Background="#1D2939" CornerRadius="13"><TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#84ADFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Acquire messages" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" /><TextBlock Text="A276 identity + transmission" FontSize="12" Foreground="#98A2B3" /></StackPanel></Grid>
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="10"><Border Width="26" Height="26" Background="#1D2939" CornerRadius="13"><TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#84ADFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Preserve evidence" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" /><TextBlock Text="Automatic raw-session save" FontSize="12" Foreground="#98A2B3" /></StackPanel></Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border IsVisible="{Binding HasTransmissionData}" Background="#064E3B" CornerRadius="14" Padding="30">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="30">
                <StackPanel Spacing="10">
                  <TextBlock Text="SNAPSHOT READY" FontSize="10" FontWeight="Bold" Foreground="#6CE9A6" LetterSpacing="1.2" />
                  <TextBlock Classes="heroTitle" Text="Vehicle evidence is ready to review" />
                  <TextBlock Text="The capture has been preserved. Move into measurements or transmission analysis without reconnecting to the vehicle." FontSize="15" Foreground="#D1FADF" TextWrapping="Wrap" LineHeight="23" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Button Classes="secondary" Content="Trouble codes" Command="{Binding NavigateTroubleCodesCommand}" />
                  <Button Classes="primary" Content="Review measurements  →" Command="{Binding NavigateLiveDataCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Spacing="11">
              <TextBlock Classes="sectionTitle" Text="Current session" />
              <Border Classes="card" Padding="0">
                <Grid ColumnDefinitions="*,*,*,*">
                  <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="22,18"><StackPanel Spacing="5"><TextBlock Classes="kicker" Text="CONNECTION" /><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding ConnectionStatus}" /><TextBlock Classes="muted" Text="Acquisition state" /></StackPanel></Border>
                  <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="22,18"><StackPanel Spacing="5"><TextBlock Classes="kicker" Text="PROTOCOL" /><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding ProtocolDecodeStatus}" /><TextBlock Classes="muted" Text="A276 snapshot" /></StackPanel></Border>
                  <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="22,18"><StackPanel Spacing="5"><TextBlock Classes="kicker" Text="RAW EVIDENCE" /><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding ReceivedByteCount}" /><TextBlock Classes="muted" Text="Bytes preserved" /></StackPanel></Border>
                  <Border Grid.Column="3" Padding="22,18"><StackPanel Spacing="5"><TextBlock Classes="kicker" Text="INTEGRITY" /><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding QualityStatus}" /><TextBlock Classes="muted" Text="Transport quality" /></StackPanel></Border>
                </Grid>
              </Border>
            </StackPanel>

            <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="18">
              <Border Grid.Column="0" Classes="card" Padding="24">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="5"><TextBlock Classes="kicker" Text="EVIDENCE CHAIN" /><TextBlock Classes="sectionTitle" Text="What this session preserves" /></StackPanel>
                  <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="11"><Border Width="28" Height="28" Background="#ECFDF3" CornerRadius="14"><TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#067647" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Original vehicle bytes" FontSize="14" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="Saved before decoding." /></StackPanel><TextBlock Grid.Column="2" Text="{Binding ReceivedByteCount}" FontSize="14" FontWeight="Bold" Foreground="#344054" VerticalAlignment="Center" /></Grid>
                  <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="11"><Border Width="28" Height="28" Background="#ECFDF3" CornerRadius="14"><TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#067647" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Deterministic replay" FontSize="14" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="Re-open without transmitting to the car." /></StackPanel><TextBlock Grid.Column="2" Text="AVAILABLE" FontSize="10" FontWeight="Bold" Foreground="#067647" VerticalAlignment="Center" /></Grid>
                  <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="11"><Border Width="28" Height="28" Background="#FFFAEB" CornerRadius="14"><TextBlock Text="!" FontSize="13" FontWeight="Bold" Foreground="#B54708" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Repair interpretation" FontSize="14" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="Held behind vehicle-validation boundaries." /></StackPanel><TextBlock Grid.Column="2" Text="PENDING" FontSize="10" FontWeight="Bold" Foreground="#B54708" VerticalAlignment="Center" /></Grid>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="24">
                <StackPanel Spacing="14">
                  <TextBlock Classes="kicker" Text="VEHICLE DEFINITION" />
                  <TextBlock Classes="sectionTitle" Text="1994 Buick Roadmaster" />
                  <TextBlock Classes="muted" Text="5.7L LT1  ·  4L60E  ·  8192-baud ALDL" />
                  <Border Height="1" Background="#E2E8F0" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" Text="Diagnostic definition" /><TextBlock Grid.Column="1" Text="A276 / $EE" FontSize="14" FontWeight="SemiBold" /></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" Text="Vehicle validation" /><Border Grid.Column="1" Background="#FFF7ED" CornerRadius="11" Padding="9,4"><TextBlock Text="PENDING" FontSize="10" FontWeight="Bold" Foreground="#B54708" /></Border></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" Text="Control capability" /><Border Grid.Column="1" Background="#ECFDF3" CornerRadius="11" Padding="9,4"><TextBlock Text="NONE" FontSize="10" FontWeight="Bold" Foreground="#067647" /></Border></Grid>
                  <Border Background="#F8FAFC" CornerRadius="8" Padding="13"><TextBlock Text="The app reads and preserves diagnostic evidence. It does not flash the PCM or command the transmission." FontSize="13" Foreground="#475467" TextWrapping="Wrap" /></Border>
                </StackPanel>
              </Border>
            </Grid>

          </StackPanel>

          <!-- Connect -->
          <StackPanel IsVisible="{Binding IsConnectPage}" Spacing="24">
            <StackPanel Spacing="7">
              <TextBlock Classes="kicker" Text="NEW CAPTURE / 02" />
              <TextBlock Classes="pageTitle" Text="New parked capture" />
              <TextBlock Classes="muted" Text="Select the ALDL interface, connect to the Roadmaster, and preserve one diagnostic snapshot." />
            </StackPanel>

            <StackPanel Spacing="11">
              <TextBlock Classes="sectionTitle" Text="Capture mode" />
              <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="14">
                <Border Grid.Column="0" Background="#EFF4FF" BorderBrush="#84ADFF" BorderThickness="2" CornerRadius="11" Padding="18">
                  <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
                    <Border Width="34" Height="34" Background="#155EEF" CornerRadius="17"><TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Parked snapshot" FontSize="16" FontWeight="SemiBold" Foreground="#102A56" /><TextBlock Text="One bounded A276 capture with automatic raw evidence preservation." FontSize="13" Foreground="#475467" TextWrapping="Wrap" /></StackPanel>
                    <Border Grid.Column="2" Background="#D1E9FF" CornerRadius="12" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="AVAILABLE" FontSize="9" FontWeight="Bold" Foreground="#175CD3" /></Border>
                  </Grid>
                </Border>
                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="11" Padding="18">
                  <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
                    <Border Width="34" Height="34" Background="#EAECF0" CornerRadius="17"><TextBlock Text="R" FontSize="12" FontWeight="Bold" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Road session" FontSize="16" FontWeight="SemiBold" Foreground="#344054" /><TextBlock Text="Real-time driving data. Requires target-vehicle cadence and restoration validation." FontSize="13" Foreground="#667085" TextWrapping="Wrap" /></StackPanel>
                    <Border Grid.Column="2" Background="#F2F4F7" CornerRadius="12" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="LOCKED" FontSize="9" FontWeight="Bold" Foreground="#475467" /></Border>
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="1.25*,*" ColumnSpacing="16">
              <Border Grid.Column="0" Classes="card" Padding="26">
                <StackPanel Spacing="20">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="5"><TextBlock Classes="kicker" Text="CONNECTION" /><TextBlock Classes="sectionTitle" Text="Current data source" /></StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="12" Padding="12,7"><TextBlock Text="ROADMASTER DATA LINK" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" /></Border>
                  </Grid>

                  <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="9" Padding="18">
                    <Grid ColumnDefinitions="58,*" ColumnSpacing="16">
                      <Border Width="58" Height="54" Background="#0F172A" CornerRadius="8"><TextBlock Text="{Binding ConnectionSourceIcon}" FontSize="13" FontWeight="Bold" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceSummary}" IsVisible="{Binding ShowDeviceSummary}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                        <ComboBox ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedDevice}"
                                  IsVisible="{Binding ShowDeviceSelector}" IsEnabled="{Binding CanSelectDevice}" MinWidth="260">
                          <ComboBox.ItemTemplate><DataTemplate x:DataType="transport:TransportDevice"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding ConnectionSourceDescription}" FontSize="15" FontWeight="Medium" Foreground="#334155" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="primary" Content="{Binding FindCablesButtonText}" Command="{Binding DiscoverCommand}" IsVisible="{Binding ShowConnectionActions}" Margin="0,0,9,9" />
                    <Button Classes="secondary" Content="Connect to vehicle  →" Command="{Binding ConnectCommand}" IsVisible="{Binding ShowConnectAction}" Margin="0,0,9,9" />
                    <Button Classes="secondary" Content="Use demo instead" Command="{Binding RunDemoCommand}" IsVisible="{Binding ShowConnectionActions}" Margin="0,0,9,9" />
                    <Button Classes="secondary" Content="{Binding DisconnectButtonText}" Command="{Binding DisconnectCommand}" IsVisible="{Binding HasActiveTransport}" Margin="0,0,9,9" />
                  </WrapPanel>

                  <Border IsVisible="{Binding ShowConnectionActions}" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="15,12">
                    <TextBlock Text="{Binding CableDiscoveryMessage}" FontSize="15" FontWeight="Medium" Foreground="#1E3A8A" TextWrapping="Wrap" />
                  </Border>

                  <Border IsVisible="{Binding IsDemoSession}" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="9" Padding="18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                      <StackPanel Spacing="5"><TextBlock Text="Demo session is active" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A8A" /><TextBlock Text="No car or cable is connected. You are viewing synthetic sample data." FontSize="15" FontWeight="Medium" Foreground="#334155" TextWrapping="Wrap" /></StackPanel>
                      <Button Grid.Column="1" Classes="secondary" Content="View measurements  →" Command="{Binding NavigateLiveDataCommand}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <Border IsVisible="{Binding ShowVehicleConnectionHelp}" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                      <StackPanel Grid.Column="0" Spacing="9"><TextBlock Classes="sectionTitle" Text="Before you connect" /><TextBlock Classes="muted" Text="1. Turn the ignition key to ON." /><TextBlock Classes="muted" Text="2. Connect the OBD-I cable to the car and your laptop." /><TextBlock Classes="muted" Text="3. Keep the car parked while starting the session." /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="9"><TextBlock Classes="sectionTitle" Text="What the app will do" /><TextBlock Classes="muted" Text="Save the original vehicle data automatically." /><TextBlock Classes="muted" Text="Read the documented diagnostic messages." /><TextBlock Classes="muted" Text="Never command the engine or transmission." /></StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="24">
                <StackPanel Spacing="20">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="SESSION STATUS" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="0.8" /><Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="11,6"><TextBlock Text="{Binding LinkBadgeStatus}" FontSize="13" FontWeight="Bold" Foreground="#BFDBFE" /></Border></Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="4"><TextBlock Text="MESSAGES RECEIVED" FontSize="13" Foreground="#CBD5E1" FontWeight="Bold" /><TextBlock Text="{Binding ValidProtocolFrameCount}" FontSize="36" FontWeight="SemiBold" Foreground="#FFFFFF" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="DATA BYTES SAVED" FontSize="13" Foreground="#CBD5E1" FontWeight="Bold" /><TextBlock Text="{Binding ReceivedByteCount}" FontSize="36" FontWeight="SemiBold" Foreground="#FFFFFF" /></StackPanel>
                  </Grid>
                  <Border Height="1" Background="#263349" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14"><StackPanel Spacing="4"><TextBlock Text="Data source" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" /><TextBlock Text="{Binding DeviceSummary}" FontSize="14" FontWeight="Medium" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding InterfaceStatus}" FontSize="13" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14"><StackPanel Spacing="4"><TextBlock Text="Connection" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" /><TextBlock Text="Cable or built-in demo connection state" FontSize="14" FontWeight="Medium" Foreground="#CBD5E1" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ConnectionDisplayStatus}" FontSize="13" FontWeight="Bold" Foreground="{Binding ConnectionDisplayStatus, Converter={x:Static converters:StatusToBrushConverter.Instance}}" VerticalAlignment="Center" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14"><StackPanel Spacing="4"><TextBlock Text="Data quality" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" /><TextBlock Text="Checks for damaged or incomplete messages" FontSize="14" FontWeight="Medium" Foreground="#CBD5E1" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding QualityStatus}" FontSize="13" FontWeight="Bold" Foreground="{Binding QualityStatus, Converter={x:Static converters:StatusToBrushConverter.Instance}}" VerticalAlignment="Center" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14"><StackPanel Spacing="4"><TextBlock Text="Diagnostic snapshot" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" /><TextBlock Text="Required Roadmaster messages received" FontSize="14" FontWeight="Medium" Foreground="#CBD5E1" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding SnapshotDisplayStatus}" FontSize="13" FontWeight="Bold" Foreground="{Binding SnapshotDisplayStatus, Converter={x:Static converters:StatusToBrushConverter.Instance}}" VerticalAlignment="Center" /></Grid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <!-- Trouble codes -->
          <StackPanel IsVisible="{Binding IsTroubleCodesPage}" Spacing="22">
            <StackPanel Spacing="7"><TextBlock Classes="kicker" Text="TROUBLE CODES / 03" /><TextBlock Classes="pageTitle" Text="Transmission trouble codes" /><TextBlock Classes="muted" Text="See what each recorded code means, what can cause it, and the first check to perform." /></StackPanel>
            <Border Background="#FFF7E6" BorderBrush="#F1D49A" BorderThickness="1" CornerRadius="7" Padding="16">
              <StackPanel Spacing="5"><TextBlock Text="VEHICLE VALIDATION PENDING" FontSize="13" FontWeight="Bold" Foreground="#854D0E" /><TextBlock Text="{Binding DtcKnowledgeStatus}" FontSize="14" FontWeight="Medium" Foreground="#713F12" TextWrapping="Wrap" /></StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding ShowNoTransmissionData}">
              <StackPanel Spacing="12"><TextBlock Classes="sectionTitle" Text="No snapshot loaded" /><TextBlock Classes="muted" Text="Start a new capture or use the built-in demo to populate this workspace." /><Button Classes="primary" Content="Start new capture  →" Command="{Binding NavigateConnectCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding ShowNoLoggedTransmissionDtcs}">
              <StackPanel Spacing="8"><TextBlock Classes="kicker" Text="SNAPSHOT RESULT" /><TextBlock Classes="sectionTitle" Text="No logged transmission DTC flags" /><TextBlock Classes="muted" Text="This reports only the decoded Message 1 flag bits. It is not a verified clean bill of health." /></StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding LoggedTransmissionDtcs}" IsVisible="{Binding HasLoggedTransmissionDtcs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DtcDisplayItem">
                  <Border Classes="card" Margin="0,0,0,12" Padding="26">
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="20">
                      <Border Width="62" Height="62" Background="#EFF6FF" CornerRadius="10" VerticalAlignment="Top"><TextBlock Text="{Binding Code}" FontSize="25" FontWeight="SemiBold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                      <StackPanel Grid.Column="1" Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding EvidenceStatus}" FontSize="11" FontWeight="Bold" Foreground="#A16207" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding PlainEnglishMeaning}" FontSize="16" FontWeight="Medium" LineHeight="24" Foreground="#1E293B" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
                          <StackPanel Grid.Column="0" Spacing="7"><TextBlock Classes="kicker" Text="POSSIBLE CAUSES — IN ORDER" /><TextBlock Text="{Binding LikelyCausesText}" FontSize="15" FontWeight="Medium" LineHeight="23" Foreground="#1E293B" TextWrapping="Wrap" /></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="7"><TextBlock Classes="kicker" Text="FIRST CHECK" /><TextBlock Text="{Binding NextTest}" FontSize="15" FontWeight="Medium" LineHeight="23" Foreground="#1E293B" TextWrapping="Wrap" /><TextBlock Classes="kicker" Text="SAFETY" Margin="0,8,0,0" /><TextBlock Text="{Binding SafetyLevel}" FontSize="15" FontWeight="SemiBold" Foreground="#7C2D12" TextWrapping="Wrap" /></StackPanel>
                        </Grid>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="14"><TextBlock Text="{Binding Limitation}" FontSize="14" FontWeight="Medium" Foreground="#475569" TextWrapping="Wrap" /></Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Live data -->
          <StackPanel IsVisible="{Binding IsLiveDataPage}" Spacing="22">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Classes="kicker" Text="LIVE DATA / 04" /><TextBlock Classes="pageTitle" Text="Snapshot measurements" /><TextBlock Classes="muted" Text="A focused diagnostic snapshot. Continuous charting comes after vehicle validation." /></StackPanel><Border Grid.Column="1" Background="#EFF6FF" CornerRadius="12" Padding="12,7" VerticalAlignment="Bottom"><TextBlock Text="{Binding EvidenceLabel}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" /></Border></Grid>
            <Border IsVisible="{Binding IsDemoSession}" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="10" Padding="18,15">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                <Border Width="34" Height="34" Background="#2563EB" CornerRadius="17"><TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="Demo loaded successfully" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A8A" /><TextBlock Text="These are synthetic sample values. Use the sidebar to explore Trouble codes and Transmission." FontSize="15" FontWeight="Medium" Foreground="#334155" TextWrapping="Wrap" /></StackPanel>
              </Grid>
            </Border>
            <Border Classes="card" IsVisible="{Binding ShowNoTransmissionData}"><StackPanel Spacing="12"><TextBlock Classes="sectionTitle" Text="No measurement snapshot" /><TextBlock Classes="muted" Text="Start a new capture or load the built-in sample data." /><Button Classes="primary" Content="Start new capture  →" Command="{Binding NavigateConnectCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
            <Grid IsVisible="{Binding HasTransmissionData}" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
              <Border Grid.Row="0" Grid.Column="0" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker" Text="ENGINE SPEED" /><TextBlock Classes="metric" Text="{Binding EngineSpeedText}" /></StackPanel></Border>
              <Border Grid.Row="0" Grid.Column="1" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker" Text="VEHICLE SPEED" /><TextBlock Classes="metric" Text="{Binding VehicleSpeedText}" /></StackPanel></Border>
              <Border Grid.Row="0" Grid.Column="2" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker" Text="IGNITION VOLTAGE" /><TextBlock Classes="metric" Text="{Binding IgnitionVoltageText}" /></StackPanel></Border>
              <Border Grid.Row="0" Grid.Column="3" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker" Text="COOLANT" /><TextBlock Classes="metric" Text="{Binding CoolantTemperatureText}" /></StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="0" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker" Text="VALID FRAMES" /><TextBlock Classes="metric" Text="{Binding ValidProtocolFrameCount}" /></StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="1" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker" Text="CHECKSUM FAILURES" /><TextBlock Classes="metric" Text="{Binding ChecksumFailureCount}" /></StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="2" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker" Text="TRANSPORT" /><TextBlock Classes="metric" Text="{Binding QualityStatus}" /></StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="3" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker" Text="CAPTURE RATE" /><TextBlock Classes="metric" Text="{Binding ChunkRateText}" /><TextBlock Classes="muted" Text="chunks / second" /></StackPanel></Border>
            </Grid>
          </StackPanel>

          <!-- Transmission -->
          <StackPanel IsVisible="{Binding IsTransmissionPage}" Spacing="22">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="7">
                <TextBlock Classes="kicker" Text="TRANSMISSION / 05" />
                <TextBlock Classes="pageTitle" Text="4L60E snapshot" />
                <TextBlock Classes="muted" Text="Command states and measurements captured from A276 Message 1. Hover a card title for its definition." />
              </StackPanel>
              <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="12" Padding="12,7" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding EvidenceLabel}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" />
              </Border>
            </Grid>
            <Border Classes="card" IsVisible="{Binding ShowNoTransmissionData}"><StackPanel Spacing="12"><TextBlock Classes="sectionTitle" Text="No transmission snapshot" /><TextBlock Classes="muted" Text="Start a new capture or load the built-in sample data." /><Button Classes="primary" Content="Start new capture  →" Command="{Binding NavigateConnectCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
            <Grid IsVisible="{Binding HasTransmissionData}" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
              <Border Grid.Row="0" Grid.Column="0" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker help" Text="COMMANDED GEAR" ToolTip.Tip="Gear requested by the PCM; this does not confirm the gear mechanically applied." AutomationProperties.HelpText="Gear requested by the PCM; this does not confirm the gear mechanically applied." /><TextBlock Classes="metric" Text="{Binding CommandedGearText}" /></StackPanel></Border>
              <Border Grid.Row="0" Grid.Column="1" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker help" Text="FLUID TEMPERATURE" ToolTip.Tip="Transmission-fluid temperature reported by the TFT sensor." AutomationProperties.HelpText="Transmission-fluid temperature reported by the TFT sensor." /><TextBlock Classes="metric" Text="{Binding FluidTemperatureText}" /></StackPanel></Border>
              <Border Grid.Row="0" Grid.Column="2" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker help" Text="OUTPUT SPEED" ToolTip.Tip="Rotational speed reported for the transmission output shaft." AutomationProperties.HelpText="Rotational speed reported for the transmission output shaft." /><TextBlock Classes="metric" Text="{Binding OutputSpeedText}" /></StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="0" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker help" Text="TORQUE SIGNAL PRESSURE" ToolTip.Tip="Pressure-related PCM data; this is not a mechanical line-pressure gauge reading." AutomationProperties.HelpText="Pressure-related PCM data; this is not a mechanical line-pressure gauge reading." /><TextBlock Classes="metric" Text="{Binding TorqueSignalPressureText}" /><TextBlock Classes="muted" Text="PCM signal, not line-pressure gauge" /></StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="1" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker help" Text="FORCE MOTOR CURRENT" ToolTip.Tip="Actual and reference current for the pressure-control solenoid." AutomationProperties.HelpText="Actual and reference current for the pressure-control solenoid." /><TextBlock Classes="metric" Text="{Binding ForceMotorCurrentText}" /><TextBlock Classes="muted" Text="actual / reference" /></StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="2" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker help" Text="FORCE MOTOR DUTY" ToolTip.Tip="PCM duty-cycle command to the pressure-control circuit." AutomationProperties.HelpText="PCM duty-cycle command to the pressure-control circuit." /><TextBlock Classes="metric" Text="{Binding ForceMotorDutyText}" /></StackPanel></Border>
              <Border Grid.Row="2" Grid.Column="0" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker help" Text="SLIP VALUE" ToolTip.Tip="PCM slip-related value. Read it alongside commanded gear, TCC state, engine speed, and output speed." AutomationProperties.HelpText="PCM slip-related value. Read it alongside commanded gear, TCC state, engine speed, and output speed." /><TextBlock Classes="metric" Text="{Binding SlipText}" /><TextBlock Classes="muted" Text="Read with gear and TCC state" /></StackPanel></Border>
              <Border Grid.Row="2" Grid.Column="1" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker help" Text="TCC COMMANDS" ToolTip.Tip="Torque-converter-clutch command and enable bits; these do not confirm clutch engagement." AutomationProperties.HelpText="Torque-converter-clutch command and enable bits; these do not confirm clutch engagement." /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding TccStatusText}" /><TextBlock Classes="muted" Text="Command state only" /></StackPanel></Border>
              <Border Grid.Row="2" Grid.Column="2" Classes="card"><StackPanel Spacing="7"><TextBlock Classes="kicker help" Text="SHIFT SOLENOIDS" ToolTip.Tip="PCM command bits for solenoids A and B, not direct electrical feedback." AutomationProperties.HelpText="PCM command bits for solenoids A and B, not direct electrical feedback." /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SolenoidStatusText}" /><TextBlock Classes="muted" Text="Command state only" /></StackPanel></Border>
            </Grid>
            <Border Classes="card" IsVisible="{Binding HasTransmissionData}">
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20"><StackPanel><TextBlock Classes="kicker help" Text="LATEST 1–2 SHIFT" ToolTip.Tip="Most recent elapsed time between recognized first- and second-gear command states." AutomationProperties.HelpText="Most recent elapsed time between recognized first- and second-gear command states." /><TextBlock Classes="metric" Text="{Binding OneTwoShiftTimeText}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Classes="kicker help" Text="LATEST 2–3 SHIFT" ToolTip.Tip="Most recent elapsed time between recognized second- and third-gear command states." AutomationProperties.HelpText="Most recent elapsed time between recognized second- and third-gear command states." /><TextBlock Classes="metric" Text="{Binding TwoThreeShiftTimeText}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Classes="kicker help" Text="TRANSMISSION PROM ID" ToolTip.Tip="Calibration identifier reported in the data stream; this is not a trouble code." AutomationProperties.HelpText="Calibration identifier reported in the data stream; this is not a trouble code." /><TextBlock Classes="metric" Text="{Binding TransmissionPromIdText}" /></StackPanel></Grid>
            </Border>
            <Border Classes="card" IsVisible="{Binding HasTransmissionTimeline}" Padding="0">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="28" Margin="24,22,24,18">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="sectionTitle" Text="Recorded transmission timeline" />
                    <TextBlock Classes="muted" Text="The latest readings in time order. These are observations, not fault judgments." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="kicker" Text="SAMPLES" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SessionSampleCountText}" /></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4"><TextBlock Classes="kicker" Text="DURATION" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SessionDurationText}" /></StackPanel>
                  <StackPanel Grid.Column="3" Spacing="4"><TextBlock Classes="kicker" Text="STATE CHANGES" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SessionEventCountText}" /></StackPanel>
                </Grid>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1" Padding="24,12">
                  <Grid ColumnDefinitions="0.9*,1.15*,1.15*,0.8*,1.1*">
                    <TextBlock Classes="kicker" Text="TIME" /><TextBlock Grid.Column="1" Classes="kicker" Text="SPEED" /><TextBlock Grid.Column="2" Classes="kicker" Text="ENGINE" /><TextBlock Grid.Column="3" Classes="kicker" Text="GEAR" /><TextBlock Grid.Column="4" Classes="kicker" Text="SLIP" />
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding TransmissionTimeline}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TransmissionTimelineItem">
                      <Border Margin="24,0" Padding="0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="0.9*,1.15*,1.15*,0.8*,1.1*">
                          <TextBlock Text="{Binding ElapsedText}" FontSize="15" FontWeight="Medium" /><TextBlock Grid.Column="1" Text="{Binding VehicleSpeedText}" FontSize="15" FontWeight="Medium" /><TextBlock Grid.Column="2" Text="{Binding EngineSpeedText}" FontSize="15" FontWeight="Medium" /><TextBlock Grid.Column="3" Text="{Binding CommandedGearText}" FontSize="15" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="{Binding SlipText}" FontSize="15" FontWeight="Medium" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="0,1,0,0" Padding="24,15"><TextBlock Text="{Binding SessionInterpretationBoundary}" FontSize="14" FontWeight="Medium" Foreground="#713F12" TextWrapping="Wrap" /></Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Sessions -->
          <StackPanel IsVisible="{Binding IsSessionsPage}" Spacing="22">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="7">
                <TextBlock Classes="kicker" Text="SAVED SESSIONS / 06" />
                <TextBlock Classes="pageTitle" Text="Review a previous session" />
                <TextBlock Classes="muted" Text="Select a capture and replay it. The app reads the saved data only; it does not connect to or control the car." TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="Open another file" Command="{Binding BrowseSessionCommand}" VerticalAlignment="Bottom" />
            </Grid>

            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="18">
              <Border Grid.Column="0" Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,*">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,14">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="sectionTitle" Text="Sessions on this computer" />
                      <TextBlock Classes="muted" Text="{Binding SessionLibraryStatus}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondary" Content="Refresh" Command="{Binding RefreshSessionsCommand}" MinWidth="96" />
                  </Grid>

                  <Border Grid.Row="1" IsVisible="{Binding ShowNoSavedSessions}" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,28">
                    <StackPanel Spacing="8">
                      <TextBlock FontSize="17" FontWeight="SemiBold" Text="No saved sessions yet" />
                      <TextBlock Classes="muted" Text="Capture data from the Roadmaster, run the built-in demo, or open a .lt1raw file from another location." TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <ListBox Grid.Row="1"
                           IsVisible="{Binding HasSavedSessions}"
                           ItemsSource="{Binding SavedSessions}"
                           SelectedItem="{Binding SelectedSavedSession}"
                           Background="Transparent"
                           BorderBrush="#E2E8F0"
                           BorderThickness="0,1,0,0"
                           Padding="10">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SavedSessionItem">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18" Margin="10,9">
                          <StackPanel Spacing="5">
                            <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CapturedText}" FontSize="14" FontWeight="Medium" Foreground="#475569" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="26">
                <StackPanel Spacing="18">
                  <StackPanel Spacing="7">
                    <TextBlock Classes="kicker" Text="REPLAY" />
                    <TextBlock Classes="sectionTitle" Text="{Binding ReplayStatus}" />
                    <TextBlock Classes="muted" Text="{Binding ReplayDetail}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="10">
                    <Button Classes="primary" Content="Replay selected session  →" Command="{Binding ReplaySelectedSessionCommand}" HorizontalAlignment="Stretch" />
                    <Button Classes="secondary" Content="Show selected file" Command="{Binding OpenSessionFolderCommand}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <Border IsVisible="{Binding HasReplayResult}" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="4"><TextBlock Classes="kicker" Text="RAW BYTES" /><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding ReceivedByteCount}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="kicker" Text="CHUNKS" /><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding ReceivedChunkCount}" /></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4"><TextBlock Classes="kicker" Text="INTEGRITY" /><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding QualityStatus}" /></StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <!-- Reports -->
          <StackPanel IsVisible="{Binding IsReportsPage}" Spacing="22">
            <StackPanel Spacing="7"><TextBlock Classes="kicker" Text="REPORTS / 07" /><TextBlock Classes="pageTitle" Text="Save and share your results" /><TextBlock Classes="muted" Text="Create a readable report or export the decoded timeline for a spreadsheet." /></StackPanel>
            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="18">
              <StackPanel Spacing="5"><TextBlock Text="VEHICLE VALIDATION PENDING" FontSize="13" FontWeight="Bold" Foreground="#854D0E" /><TextBlock Text="Reports include recorded facts and source-backed code explanations. They do not call a value normal or abnormal until a matching baseline is verified." FontSize="15" FontWeight="Medium" Foreground="#713F12" TextWrapping="Wrap" /></StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding ShowNoTransmissionData}" Padding="28">
              <StackPanel Spacing="12"><TextBlock Classes="sectionTitle" Text="Load measurements first" /><TextBlock Classes="muted" Text="Run the demo, capture the Roadmaster, or replay a saved session before creating a report." /><Button Classes="primary" Content="Open saved sessions" Command="{Binding NavigateSessionsCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding HasTransmissionData}" Padding="28">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="9" Padding="22">
                  <StackPanel Spacing="10"><TextBlock Classes="kicker" Text="READABLE REPORT" /><TextBlock Classes="sectionTitle" Text="Diagnostic report" /><TextBlock Text="A clean web page with session quality, trouble-code explanations, and the recorded transmission timeline. Open it in any browser and print it to PDF if desired." FontSize="15" FontWeight="Medium" Foreground="#334155" TextWrapping="Wrap" LineHeight="22" /><Button Classes="primary" Content="Save diagnostic report" Command="{Binding ExportReportCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="9" Padding="22">
                  <StackPanel Spacing="10"><TextBlock Classes="kicker" Text="SPREADSHEET DATA" /><TextBlock Classes="sectionTitle" Text="Measurement export" /><TextBlock Text="A CSV file containing every decoded sample with time, speed, RPM, commanded gear, slip, temperature, voltage, current, and command states." FontSize="15" FontWeight="Medium" Foreground="#334155" TextWrapping="Wrap" LineHeight="22" /><Button Classes="secondary" Content="Export measurements" Command="{Binding ExportCsvCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" /></StackPanel>
                </Border>
              </Grid>
            </Border>
            <Border Classes="card" Padding="20">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{Binding ReportStatus}" FontSize="15" FontWeight="Medium" Foreground="#334155" VerticalAlignment="Center" TextWrapping="Wrap" /><Button Grid.Column="1" Classes="secondary" Content="Show saved file" Command="{Binding OpenReportFolderCommand}" /></Grid>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
